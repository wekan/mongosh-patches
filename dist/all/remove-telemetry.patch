-import { promises as fs } from 'fs';
+import { promises as fs, accessSync, constants as fsConstants } from 'fs';
 import path from 'path';
 import os from 'os';
 import { EventEmitter } from 'events';
 import { EJSON } from 'bson';
 
+/**
+ * Fork change: os.homedir() is not always writable — a container that runs as
+ * a user with no /etc/passwd entry (e.g. FerretDB's default image) reports it
+ * as '/nonexistent', which is not creatable. Writing config/log/history data
+ * there fails with EACCES/ENOENT instead of falling back anywhere, and mongosh
+ * reported that as a startup warning plus "Could not open history file" on
+ * every session. Fall back to a writable, session-scoped directory under the
+ * OS temp dir instead of the unwritable home directory.
+ */
+function resolveWritableHomeBase(): string {
+  const home = os.homedir();
+  try {
+    accessSync(home, fsConstants.W_OK);
+    return home;
+  } catch {
+    return path.join(os.tmpdir(), `mongosh-${process.getuid ? process.getuid() : 'nouid'}`);
+  }
+}
+
